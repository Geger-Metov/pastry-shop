# --- Docker Compose (читается из корневого .env) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Валюта магазина, ISO 4217 (например RUB, EUR, KGS) - обязательна.
# Её читает только backend; фронтенд получает валюту через GET /shop.
SHOP_CURRENCY=
# Необязательно: код страны для национальных номеров телефона (например 7 или 996)
PHONE_DEFAULT_COUNTRY_CODE=
