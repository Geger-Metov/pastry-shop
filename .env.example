# --- Docker Compose (читается из корневого .env) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Валюта магазина, ISO 4217 (например RUB, EUR, KGS) - обязательна
SHOP_CURRENCY=
# Необязательно: код страны для национальных номеров телефона (например 7)
PHONE_DEFAULT_COUNTRY_CODE=

# --- Backend без Docker (читается из backend/.env.local) ---
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/DBNAME
SHOP_CURRENCY=
PHONE_DEFAULT_COUNTRY_CODE=
